// =============================================================================
// News module (slice A4): news posts with a draft/scheduled/published/archived
// lifecycle and the admin-managed list of useful links (SPEC §4.6, §5.5).
// =============================================================================

enum NewsType {
  changelog
  update
  information

  @@map("news_type")
}

enum NewsStatus {
  draft
  scheduled
  published
  archived

  @@map("news_status")
}

model NewsPost {
  id           String     @id @default(uuid(7)) @db.Uuid
  title        String
  type         NewsType
  status       NewsStatus @default(draft)
  /// <= 280 characters, plain text.
  summary      String
  /// Sanitised on write with an allowlist (SPEC §4.6).
  bodyHtml     String     @map("body_html")
  coverImageId String?    @map("cover_image_id") @db.Uuid
  pinned       Boolean    @default(false)
  publishAt    DateTime?  @map("publish_at") @db.Timestamptz(3)
  expireAt     DateTime?  @map("expire_at") @db.Timestamptz(3)
  publishedAt  DateTime?  @map("published_at") @db.Timestamptz(3)
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(3)
  authorId     String     @map("author_id") @db.Uuid
  updatedById  String?    @map("updated_by_id") @db.Uuid
  /// Soft delete (draft or archived only).
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  coverImage Attachment? @relation("NewsPostCover", fields: [coverImageId], references: [id])
  author     User        @relation("NewsPostAuthor", fields: [authorId], references: [id])
  updatedBy  User?       @relation("NewsPostUpdatedBy", fields: [updatedById], references: [id])

  @@index([status, publishAt])
  @@index([status, publishedAt(sort: Desc)])
  @@map("news_posts")
}

model UsefulLink {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// <= 80 characters
  title       String
  /// https:// only
  url         String
  /// <= 200 characters
  description String?
  /// Icon from the allowlist (SPEC §4.6).
  icon        String?
  category    String?
  sortOrder   Int      @map("sort_order")
  active      Boolean  @default(true)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User @relation("UsefulLinkCreatedBy", fields: [createdById], references: [id])

  @@index([sortOrder])
  @@map("useful_links")
}
