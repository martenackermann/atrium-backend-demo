// Foundation-owned models shared by every module. Do not edit from a slice.

/// Append-only audit trail. Written by WorkflowService for every state transition
/// and available to modules for other auditable events.
model AuditEntry {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Resource type, e.g. "TrainingRequest".
  entityType String
  entityId   String
  /// Action slug, e.g. "approve" or "created".
  action     String
  fromState  String?
  toState    String?
  /// Id of the acting user (null for system jobs).
  actorId    String?
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@map("audit_entries")
}

/// Small key/value store for system flags (e.g. "seed.completedAt").
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
