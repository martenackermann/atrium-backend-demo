# Local development defaults (placeholders only - never put real secrets here).
NODE_ENV=development
PORT=3100
LOG_LEVEL=debug

# Shared dev Postgres (docker container ah-postgres)
DATABASE_URL=postgresql://dev:dev@localhost:5432/atrium_main

# Auth (demo only - generate your own secret for anything public)
JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
JWT_TTL=8h

# Mail (Mailpit: SMTP localhost:1025, UI http://localhost:8025)
# 127.0.0.1 rather than localhost: nodemailer resolves names via DNS, not the hosts file.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Atrium <no-reply@example.com>"

# URLs
APP_URL=http://localhost:3100
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Demo behaviour (persona login, demo banners, resettable data)
DEMO_MODE=true

# Uploaded files (relative to the working directory)
STORAGE_DIR=./storage
